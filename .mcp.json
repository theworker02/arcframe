{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "arcframe": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${PLUGIN_ROOT}/servers/mcp/dist/index.js"
      ],
      "cwd": "${PLUGIN_ROOT}",
      "env": {
        "ARCFRAME_ROOT": "${PLUGIN_ROOT}"
      }
    }
  }
}
